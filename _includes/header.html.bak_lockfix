<!-- Header / Navigation -->
<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300" x-data="{ scrolled: false }" @scroll.window="scrolled = window.scrollY > 20" :class="scrolled ? 'bg-white/80 dark:bg-[#0f172a]/80 backdrop-blur-xl shadow-sm' : 'bg-transparent'">
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    
    <!-- Logo -->
    <a href="{{ '/' | relative_url }}" class="flex items-center space-x-2 group">
      <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-primary-500 to-accent-500 flex items-center justify-center text-white font-bold text-sm shadow-lg shadow-primary-500/25 group-hover:shadow-primary-500/40 transition-shadow">
        <i class="fas fa-cat text-xs"></i>
      </div>
      <span class="text-lg font-bold bg-gradient-to-r from-primary-600 to-accent-500 dark:from-primary-400 dark:to-accent-400 bg-clip-text text-transparent">
        龙猫云
      </span>
    </a>

    <!-- Desktop Nav -->
    <div class="hidden md:flex items-center space-x-1">
      {% if site.data.navigation.main %}
        {% for item in site.data.navigation.main %}
        <a href="{{ item.url | relative_url }}" class="px-3 py-2 text-sm font-medium rounded-lg transition-all duration-200 {% if page.url == item.url %}text-primary-600 dark:text-primary-400 bg-primary-50 dark:bg-primary-500/10{% else %}text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-white/5{% endif %}">
          {% if item.icon %}<i class="{{ item.icon }} mr-1.5"></i>{% endif %}
          {{ item.title }}
        </a>
        {% endfor %}
      {% endif %}
    </div>

    <!-- Right Actions -->
    <div class="flex items-center space-x-3">
      <!-- Dark Mode Toggle -->
      <button @click="darkMode = !darkMode" class="p-2 rounded-lg text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-white/5 transition-all" aria-label="切换主题">
        <i class="fas fa-sun text-lg" x-show="!darkMode"></i>
        <i class="fas fa-moon text-lg" x-show="darkMode" style="display: none;"></i>
      </button>

      <!-- Mobile Menu Toggle -->
      <button @click="mobileMenuOpen = !mobileMenuOpen" class="md:hidden p-2 rounded-lg text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-white/5 transition-all" aria-label="菜单">
        <i class="fas fa-bars text-lg" x-show="!mobileMenuOpen"></i>
        <i class="fas fa-times text-lg" x-show="mobileMenuOpen" style="display: none;"></i>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div x-show="mobileMenuOpen" x-collapse.duration.300ms class="md:hidden border-t border-gray-200 dark:border-gray-700/50 bg-white/95 dark:bg-[#0f172a]/95 backdrop-blur-xl">
    <div class="container mx-auto px-4 py-3 space-y-1">
      {% if site.data.navigation.main %}
        {% for item in site.data.navigation.main %}
        <a href="{{ item.url | relative_url }}" class="block px-3 py-2.5 rounded-lg text-sm font-medium text-gray-700 dark:text-gray-300 hover:text-primary-600 dark:hover:text-primary-400 hover:bg-primary-50 dark:hover:bg-primary-500/10 transition-all">
          {% if item.icon %}<i class="{{ item.icon }} mr-2"></i>{% endif %}
          {{ item.title }}
        </a>
        {% endfor %}
      {% endif %}
    </div>
  </div>
  
</header>
<!-- 弹窗样式与脚本开始 -->
<style>
#popupOverlay {
display: none;
position: fixed;
top: 0;
left: 0;
width: 100%;
height: 100%;
background: rgba(0, 0, 0, 0.5);
backdrop-filter: blur(4px);
-webkit-backdrop-filter: blur(4px);
align-items: center;
justify-content: center;
z-index: 9999;
padding: 10px;
box-sizing: border-box;
}
#popupOverlay.show {
display: flex;
}
.popup-content {
background: #fff;
padding: 20px 30px;
border-radius: 12px;
max-width: 100%;
width: 370px;
text-align: center;
position: relative;
box-shadow: 0 0 15px rgba(0, 0, 0, 0.3);
box-sizing: border-box;
max-height: 90vh;
overflow-y: auto;
}
.popup-close-btn {
text-decoration: none;
position: absolute;
top: 5px;
right: 5px;
width: 32px;
height: 32px;
border-radius: 50%;
background: rgba(0, 0, 0, 0.05);
border: none;
font-size: 20px;
font-weight: bold;
color: #999;
cursor: pointer;
transition: all 0.3s;
flex-shrink: 0;
touch-action: manipulation;
display: flex;
align-items: center;
justify-content: center;
line-height: 1;
z-index: 10;
}
.popup-close-btn:hover {
background: #f44336;
color: #fff;
}
.popup-link {
text-decoration: none;
color: inherit;
display: block;
}
.popup-title {
margin: 0 0 10px;
font-size: 24px;
font-weight: bold;
color: #ff4d4f;
word-wrap: break-word;
}
.popup-image {
width: 100%;
max-width: 300px;
height: auto;
display: block;
margin: 0 auto 15px;
border-radius: 8px;
}
.popup-shop-btn {
display: inline-block;
width: 100%;
background: #e11d48;
color: #fff;
font-weight: bold;
padding: 12px 1px;
border-radius: 8px;
text-decoration: none;
transition: background 0.3s;
box-shadow: 0 4px 6px rgba(0,0,0,0.1);
}
.popup-shop-btn:hover {
background: #be123c;
}
@media (max-width: 768px) {
.popup-content {
width: 95%;
max-width: 320px;
padding: 15px 20px;
}
.popup-title {
font-size: 20px;
}
.popup-close-btn {
width: 28px;
height: 28px;
font-size: 18px;
}
}
</style>
<!-- 弹窗 HTML 结构 -->
<div id="popupOverlay">
<div class="popup-content">
<div style="display: flex; flex-direction: column; gap: 1rem;">
<a href="https://ml.yfqz1.net/register?code=PCC6A3bC" target="_blank" class="popup-link">
<p class="popup-title">Clash 机场推荐</p>
<img src="https://xiaohuojianzhanghao.github.io/img/6a229370bf0c1.png" alt="机场地址" class="popup-image">
</a>
<div style="border-top: 1px solid #f3f4f6; padding-top: 1rem;">
<a href="http://shop.xinkonyun.cc/" target="_blank" class="popup-shop-btn">
购买 Shadowrocket 独享账号/海外其他账号
</a>
</div>
</div>
<a href="https://ml.yfqz1.net/register?code=PCC6A3bC" target="_blank" rel="noopener noreferrer" class="popup-close-btn" id="popupCloseBtn" aria-label="关闭弹窗并前往推荐">&times;</a>
</div>
</div>
<!-- 弹窗控制脚本 -->
<script>
(function() {
var popupOverlay = document.getElementById('popupOverlay');
var popupCloseBtn = document.getElementById('popupCloseBtn');
if (!popupOverlay || !popupCloseBtn) return;
var locked = false;
function lockScroll() {
if (locked) return;
locked = true;
document.body.style.overflow = 'hidden';
document.documentElement.style.overflow = 'hidden';
document.addEventListener('touchmove', preventBgScroll, { passive: false });
document.addEventListener('wheel', preventBgScroll, { passive: false });
}
function unlockScroll() {
if (!locked) return;
locked = false;
document.body.style.overflow = '';
document.documentElement.style.overflow = '';
document.removeEventListener('touchmove', preventBgScroll);
document.removeEventListener('wheel', preventBgScroll);
}
function preventBgScroll(e) {
if (popupOverlay.classList.contains('show')) {
e.preventDefault();
}
}
// 立即显示弹窗（先弹窗后网页），弹窗期间锁定背后滚动
function showPopup() {
popupOverlay.classList.add('show');
lockScroll();
}
function hidePopup() {
popupOverlay.classList.remove('show');
unlockScroll();
}
window.addEventListener('DOMContentLoaded', function() {
showPopup();
// 关闭按钮
popupCloseBtn.addEventListener('click', function(e) {
e.preventDefault();
e.stopPropagation();
hidePopup();
});
// 点击遮罩层关闭弹窗并跳转推广链接
popupOverlay.addEventListener('click', function(e) {
if (e.target === popupOverlay) {
hidePopup();
var promoUrl = popupCloseBtn.getAttribute('href');
if (promoUrl) {
window.open(promoUrl, '_blank');
}
}
});
// ESC 键关闭
document.addEventListener('keydown', function(e) {
if (e.key === 'Escape' && popupOverlay.classList.contains('show')) {
hidePopup();
}
});
});
})();
</script>

<!-- Spacer for fixed header -->
<div class="h-16"></div>
